# Copy to backend/.env (or run `node scripts/sync-secrets.mjs` from the repo root). Never commit real values.

# --- server ---
PORT=8787
# Public HTTPS base URL Agora's cloud uses to reach /v1/sessions/:id/chat/completions (tunnel or Railway domain)
PUBLIC_URL=
# Where the JSON db + Codex work dir live (Docker/Railway: /data)
XERXES_DATA_DIR=
# The user's timezone for "today" (days left, delivery dates). Default Asia/Kolkata; the server may run in UTC.
XERXES_TZ=

# --- Agora Conversational AI (voice) ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Optional: REST Basic auth. If unset, ConvoAI token auth is built from the App Certificate.
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_ASR_VENDOR=
AGORA_ASR_LANGUAGE=

# --- Murf Falcon TTS ---
MURF_API_KEY=
MURF_VOICE=
MURF_LOCALE=
MURF_STREAM_URL=

# --- Codex CLI brain (auth: `codex login --device-auth`, stored in CODEX_HOME) ---
CODEX_MODEL=
CODEX_REASONING=
CODEX_BIN=
CODEX_HOME=

# --- optional LLM / search keys ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_GATEWAY_API_KEY=
XERXES_MODEL=
XERXES_VOICE_MODEL=
TAVILY_API_KEY=
# Reddit app-only OAuth ("script" app at https://www.reddit.com/prefs/apps) for second-hand homelab listings
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# CheapShark needs a descriptive User-Agent; a generic one is used when unset
CHEAPSHARK_USER_AGENT=
# Codex native web search: live | cached | disabled
CODEX_WEB_SEARCH=
WATCH_INTERVAL_MIN=
